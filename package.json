{
  "name": "@mirafive/sdk-server",
  "version": "1.0.0",
  "description": "MIRA FIVE server SDK for JS runtimes",
  "keywords": [
    "analytics",
    "cookieless",
    "edge",
    "gdpr",
    "mirafive",
    "privacy",
    "server"
  ],
  "homepage": "https://mirafive.io",
  "bugs": {
    "email": "support@mirafive.io"
  },
  "license": "MIT",
  "author": "MIRA FIVE <support@mirafive.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-server.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:runtimes": "bun run build && node test/runtimes/run.mjs",
    "golden": "MIRAFIVE_WRITE_GOLDEN=1 vitest run test/golden.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "size": "size-limit",
    "vendor:protocol": "bun scripts/vendor-protocol.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && publint --strict && attw --pack --profile esm-only && size-limit",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "miniflare": "^4.20260730.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "index",
      "path": "dist/index.js",
      "limit": "3.62 kB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4",
  "mirafive": {
    "protocol": [
      "types",
      "limits",
      "batch-id"
    ]
  }
}
